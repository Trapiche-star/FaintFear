  m_Script: {fileID: 11500000, guid: 31cacdc2cbe100545926ffe85d19e5d1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionEnabled: 1
  isLocked: 1
  sequenceText: {fileID: 0}
  lockedMessages:
  - "\uC7A0\uACA8 \uC788\uB294 \uAC83 \uAC19\uC9C4 \uC54A\uC740\uB370\u2026 \uC65C
    \uC5F4\uB9AC\uC9C0 \uC54A\uC9C0?"
  - "\uC190\uC7A1\uC774\uB294 \uC6C0\uC9C1\uC774\uB294\uB370, \uBB38\uC740 \uAFC8\uCA4D\uB3C4
    \uD558\uC9C0 \uC54A\uB294\uB2E4."
  - "\uB35C\uCEF9\uAC70\uB9AC\uAE30\uB9CC \uD560 \uBFD0, \uBB38\uC740 \uC5F4\uB9B4
    \uAE30\uBBF8\uAC00 \uC5C6\uB2E4."
  - "\uACE0\uC7A5 \uB09C \uAC74\uAC00\u2026 \uC544\uB2C8\uBA74 \uB0B4\uAC00 \uBB54\uAC00
    \uB193\uCE58\uACE0 \uC788\uB294 \uAC74\uAC00."
  - "\uC7A0\uAE08 \uC7A5\uCE58\uB294 \uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uB7F0\uB370\uB3C4\u2026
    \uB9C9\uD600 \uC788\uB2E4."
  - "\uBD84\uBA85 \uC5F4\uB9B4 \uAC83 \uAC19\uC740\uB370, \uB9C8\uCE58 \uBCF4\uC774\uC9C0
    \uC54A\uB294 \uC190\uC774 \uBD99\uC7A1\uACE0 \uC788\uB294 \uAC83 \uAC19\uB2E4."
  - "\uBB38\uC774 \uC544\uB2C8\uB77C, \uB0B4\uAC00 \uB9C9\uD788\uACE0 \uC788\uB294
    \uAC74\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB2E4"
  defaultLockedMessage: "\uC7A0\uACA8 \uC788\uB294 \uAC83 \uAC19\uB2E4."
